# Custom Spark image with Iceberg support
FROM apache/spark:3.5.6-scala2.12-java17-python3-r-ubuntu

# Copy Iceberg JARs to the Spark jars directory
# Using S3FileIO with AWS SDK v2 only (no Hadoop S3A)
COPY jars/iceberg-spark-runtime-3.5_2.12-1.9.2.jar /opt/spark/jars/
COPY jars/iceberg-aws-1.9.2.jar /opt/spark/jars/
COPY jars/aws-sdk-java-2.28.29-bundle.jar /opt/spark/jars/
